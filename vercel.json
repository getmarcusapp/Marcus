{
  "outputDirectory": "public",
  "buildCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/meditations", "destination": "/", "permanent": false },
    { "source": "/meditations/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/dispatches.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
