# APPEND what you need to .env.local. Do NOT copy this file over it:
# .env.local already holds other project secrets and cp would destroy them.
#
#   open -e .env.local
#
# Brave Search API (outreach discovery): https://brave.com/search/api/
# 2,000 queries/month free, which is far more than this needs.
BRAVE_API_KEY=

# Or Serper instead, if you prefer: https://serper.dev
# SERPER_API_KEY=

# Google Search Console (read-only, for scripts/gsc.js).
# Service account key file, kept OUTSIDE the repo. Never paste the key itself
# anywhere but this file's target: it is a private key.
GSC_KEY_PATH=
# A domain property is "sc-domain:getmarcus.app".
# A URL-prefix property is "https://getmarcus.app/" (trailing slash matters).
GSC_PROPERTY=
