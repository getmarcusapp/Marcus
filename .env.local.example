# APPEND what you need to .env.local. Do NOT copy this file over it:
# .env.local already holds other project secrets and cp would destroy them.
#
#   open -e .env.local
#
# Brave Search API (outreach discovery): https://brave.com/search/api/
# 2,000 queries/month free, which is far more than this needs.
BRAVE_API_KEY=

# Or Serper instead, if you prefer: https://serper.dev
# SERPER_API_KEY=
