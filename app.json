{
  "expo": {
    "name": "Marcus",
    "slug": "Marcus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gioblanco.marcus",
      "newArchEnabled": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthUpdateUsageDescription": "Marcus syncs your daily Stoic practice as Mindful Minutes so your reflection time is counted alongside meditation and breathwork."
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": [],
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "scheme": "marcus",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0a0a0a",
          "defaultChannel": "default"
        }
      ],
      "react-native-health"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "230367c9-90a1-453c-8717-ee248ed3eb1b"
      }
    },
    "owner": "gioblanco"
  }
}
